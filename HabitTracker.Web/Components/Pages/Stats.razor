@page "/stats"
@rendermode InteractiveServer
@attribute [Authorize]
@using HabitTracker.Web.Models
@inject IHabitService HabitService

<div class="page-header">
    <h3>Stats</h3>
    <div class="subtitle">Which habits need attention.</div>
</div>

@if (habits == null)
{
    <p>Loading...</p>
}
else if (!habits.Any())
{
    <p>Add some habits first to see stats here.</p>
}
else
{
    <div class="row mb-4 g-3">
        <div class="col-sm-6">
            <div class="stat-card">
                <div class="stat-number">@habits.Count</div>
                <div class="stat-label">Habits Tracked</div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="stat-card">
                <div class="stat-number">@(bestStreakHabit != null ? bestStreakValue.ToString() : "0")</div>
                <div class="stat-label">
                    Best Active Streak
                    @if (bestStreakHabit != null)
                    {
                        <span>(@bestStreakHabit.Name)</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <h5>Habits — needing attention first</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Habit</th>
                <th>Current Streak</th>
                <th>Longest Streak</th>
                <th>Total Completions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in leaderboard)
            {
                <tr>
                    <td>@row.Habit.Name</td>
                    <td class="mono @(row.CurrentStreak == 0 ? "text-muted" : "")">@row.CurrentStreak</td>
                    <td class="mono">@row.LongestStreak</td>
                    <td class="mono">@row.Habit.Completions.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<Habit>? habits;
    private Habit? bestStreakHabit;
    private int bestStreakValue;
    private List<(Habit Habit, int CurrentStreak, int LongestStreak)> leaderboard = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        habits = await HabitService.GetHabitsAsync(userId);

        leaderboard = habits
            .Select(h => (Habit: h, CurrentStreak: HabitService.GetCurrentStreak(h), LongestStreak: HabitService.GetLongestStreak(h)))
            .OrderBy(r => r.CurrentStreak)
            .ThenByDescending(r => r.LongestStreak)
            .ToList();

        foreach (var row in leaderboard)
        {
            if (row.CurrentStreak > bestStreakValue)
            {
                bestStreakValue = row.CurrentStreak;
                bestStreakHabit = row.Habit;
            }
        }
    }
}
