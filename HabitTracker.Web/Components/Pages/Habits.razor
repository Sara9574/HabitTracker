@page "/habits"
@rendermode InteractiveServer

@inject IHabitService HabitService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <h3>My Habits</h3>
    <div class="subtitle">Track today, build the streak.</div>
</div>

@if (habits == null)
{
    <p>Loading...</p>
}
else if (!habits.Any())
{
    <p>No habits yet. <a href="/add-habit">Add your first one</a>.</p>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var habit in habits)
        {
            var completedToday = HabitService.IsCompletedToday(habit);
            var weekly = HabitService.GetWeeklyCompletions(habit);
            var percent = HabitService.GetProgressPercentage(habit);
            var progressColor = HabitService.GetProgressColor(percent);
            var currentStreak = HabitService.GetCurrentStreak(habit);
            var longestStreak = HabitService.GetLongestStreak(habit);
            var accent = habitColors.TryGetValue(habit.Id, out var c) ? c : "#e2a33b";

            <div class="habit-card" style="--habit-color: @accent;">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div class="habit-name">@habit.Name</div>
                        <div class="text-muted small mono">@weekly / @habit.WeeklyGoal this week</div>

                        <div class="mt-2 d-flex gap-2 flex-wrap">
                            @if (currentStreak > 0)
                            {
                                <span class="streak-badge current" title="Current streak">
                                    🔥 @currentStreak day@(currentStreak == 1 ? "" : "s")
                                </span>
                            }
                            @if (longestStreak > 0)
                            {
                                <span class="streak-badge best" title="Longest streak ever">
                                    🏆 best @longestStreak
                                </span>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-1">
                        <button type="button"
                                class="btn btn-sm @(completedToday ? "btn-outline-secondary" : "btn-success")"
                                @onclick="() => ToggleDone(habit.Id)">
                            @(completedToday ? "Undo" : "Mark as Done")
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                @onclick="() => GoToEdit(habit.Id)">
                            Edit
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => DeleteHabit(habit.Id)">
                            Delete
                        </button>
                    </div>
                </div>

                <div class="progress mt-3" style="max-width: 320px; height: 10px;">
                    <div class="progress-bar @progressColor"
                         role="progressbar"
                         style="width: @percent%;"
                         aria-valuenow="@percent"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Habit> habits = new();
    private Dictionary<int, string> habitColors = new();

    protected override async Task OnInitializedAsync()
    {
        habits = await HabitService.GetHabitsAsync();
        habitColors = HabitService.GetHabitColors(habits);
    }

    private async Task ToggleDone(int habitId)
    {
        await HabitService.ToggleCompletionAsync(habitId);
        habits = await HabitService.GetHabitsAsync(); // refresh list
        habitColors = HabitService.GetHabitColors(habits);
    }

    private void GoToEdit(int habitId)
    {
        Nav.NavigateTo($"/edit-habit/{habitId}");
    }

    private async Task DeleteHabit(int habitId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete this habit? This cannot be undone.");
        if (!confirmed)
            return;

        await HabitService.RemoveHabitAsync(habitId);
        habits = await HabitService.GetHabitsAsync();
        habitColors = HabitService.GetHabitColors(habits);
    }
}
