@page "/habits"
@rendermode InteractiveServer

@inject IHabitService HabitService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>My Habits</h3>

@if (habits == null)
{
    <p>Loading...</p>
}
else if (!habits.Any())
{
    <p>No habits yet. <a href="/add-habit">Add your first one</a>.</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var habit in habits)
        {
            var completedToday = HabitService.IsCompletedToday(habit);
            var weekly = HabitService.GetWeeklyCompletions(habit);
            var percent = HabitService.GetProgressPercentage(habit);
            var color = HabitService.GetProgressColor(percent);

            <li class="mb-4 p-3 border rounded">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@habit.Name</strong>
                        <span class="text-muted"> — @weekly / @habit.WeeklyGoal this week</span>
                    </div>

                    <div>
                        <button type="button"
                                class="btn btn-sm @(completedToday ? "btn-outline-secondary" : "btn-success")"
                                @onclick="() => ToggleDone(habit.Id)">
                            @(completedToday ? "Undo" : "Mark as Done")
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary ms-1"
                                @onclick="() => GoToEdit(habit.Id)">
                            Edit
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger ms-1"
                                @onclick="() => DeleteHabit(habit.Id)">
                            Delete
                        </button>
                    </div>
                </div>

                <div class="progress mt-2" style="max-width: 300px;">
                    <div class="progress-bar @color"
                         role="progressbar"
                         style="width: @percent%;"
                         aria-valuenow="@percent"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @percent%
                    </div>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<Habit> habits = new();

    protected override async Task OnInitializedAsync()
    {
        habits = await HabitService.GetHabitsAsync();
    }

    private async Task ToggleDone(int habitId)
    {
        await HabitService.ToggleCompletionAsync(habitId);
        habits = await HabitService.GetHabitsAsync(); // refresh list
    }

    private void GoToEdit(int habitId)
    {
        Nav.NavigateTo($"/edit-habit/{habitId}");
    }

    private async Task DeleteHabit(int habitId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete this habit? This cannot be undone.");
        if (!confirmed)
            return;

        await HabitService.RemoveHabitAsync(habitId);
        habits = await HabitService.GetHabitsAsync();
    }
}
