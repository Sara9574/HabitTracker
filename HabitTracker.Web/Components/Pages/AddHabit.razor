@page "/add-habit"
@using HabitTracker.Web.Models
@using Microsoft.AspNetCore.Components.Forms
@inject IHabitService HabitService
@inject NavigationManager Nav

<h3>Add a New Habit</h3>

<EditForm Model="@habit" OnValidSubmit="HandleValidSubmit" FormName="AddHabitForm">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Habit Name</label>
        <InputText class="form-control" @bind-Value="habit.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Weekly Goal</label>
        <InputNumber class="form-control" @bind-Value="habit.WeeklyGoal"/>
    </div>

    <button class="btn btn-primary" type="submit">Add Habit</button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private Habit habit { get; set; } = new();

    private async Task HandleValidSubmit()
    {
        habit.CreatedAt = DateTime.UtcNow;

        await HabitService.AddHabitAsync(habit);

        Nav.NavigateTo("/habits");
    }
}
